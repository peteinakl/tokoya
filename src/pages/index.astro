---
/**
 * HOME — golden page.
 *
 * The job: establish the brand in three seconds and route the visitor to
 * the right shop. Two shops on two booking systems means the homepage's
 * primary action is a CHOICE, not a button.
 *
 * Design rules in use here, all documented in DESIGN.md:
 *   - Ink hero, paper body, ink footer. Ground inversion instead of cards.
 *   - Left-aligned on an asymmetric grid. Nothing is centred.
 *   - One curved shape on the site: the disc, lifted from the logo.
 *   - Rules and ground changes separate content. No shadows anywhere.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import OpenNow from '../components/OpenNow.astro';
import SectionHead from '../components/SectionHead.astro';
import { toSchema, openDaysSummary } from '../lib/hours';
import { atLocation, priceFrom, formatPrice, formatDuration } from '../lib/prices';

const ORDER = ['ponsonby', 'remuera'];
const locations = (await getCollection('locations')).sort(
  (a, b) => ORDER.indexOf(a.data.slug) - ORDER.indexOf(b.data.slug)
);
const services = await getCollection('services');
const team = (await getCollection('team')).filter((t) => t.data.confirmed);

const ponsonby = locations.find((l) => l.data.slug === 'ponsonby')!;
const remuera = locations.find((l) => l.data.slug === 'remuera')!;

const from = priceFrom(services.filter((s) => s.data.group === 'haircuts'));

// Six services worth surfacing. The full list lives on /prices/.
const featured = ['mens-haircut', 'skin-fade', 'hot-towel-shave', 'beard-trim', 'child-haircut', 'gel-manicure']
  .map((slug) => services.find((s) => s.slug === slug))
  .filter(Boolean) as typeof services;

const SITE = 'https://www.tokoya.co.nz';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE}/#organization`,
    name: 'Tokoya Barber & Shop',
    url: `${SITE}/`,
    logo: `${SITE}/brand/lockup-1200.png`,
    founder: { '@type': 'Person', name: 'Kaisei Sarai' },
    foundingDate: '2015',
    areaServed: { '@type': 'City', name: 'Auckland' },
    sameAs: [
      'https://www.instagram.com/tokoya_barber_shop/',
      'https://www.facebook.com/tokoya.barbershop/',
    ],
    department: locations.map((l) => ({ '@id': `${SITE}/${l.data.slug}/#business` })),
  },
  ...locations.map((l) => ({
    '@context': 'https://schema.org',
    '@type': 'HairSalon',
    '@id': `${SITE}/${l.data.slug}/#business`,
    name: l.data.name,
    url: `${SITE}/${l.data.slug}/`,
    ...(l.data.telephone ? { telephone: l.data.telephone } : {}),
    ...(l.data.email ? { email: l.data.email } : {}),
    priceRange: '$$',
    currenciesAccepted: 'NZD',
    address: {
      '@type': 'PostalAddress',
      streetAddress: l.data.streetAddress,
      addressLocality: l.data.suburb,
      addressRegion: l.data.city,
      ...(l.data.postalCode ? { postalCode: l.data.postalCode } : {}),
      addressCountry: l.data.country,
    },
    openingHoursSpecification: toSchema(l.data.hours),
    parentOrganization: { '@id': `${SITE}/#organization` },
    potentialAction: {
      '@type': 'ReserveAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: l.data.bookingUrl,
        actionPlatform: [
          'https://schema.org/DesktopWebPlatform',
          'https://schema.org/MobileWebPlatform',
        ],
      },
      result: { '@type': 'Reservation', name: `Book at ${l.data.name}` },
    },
  })),
];
---

<BaseLayout
  title="Tokoya Barber & Shop | Barbers in Ponsonby & Remuera, Auckland"
  description={`Japanese-influenced barbering in Auckland since 2015. Two shops, seven days at Ponsonby. Haircuts from $${from}, skin fades $55, hot towel shaves $65. Book online.`}
  schema={schema}
>

  <!-- ==========================================================
       HERO: Atmospheric full-bleed image with dark vignette overlay
       ========================================================== -->
  <section class="hero-cinematic">
    <div class="hero-cinematic__bg" style="background-image: url('/images/hero/hero-chair.png');"></div>
    <div class="hero-cinematic__overlay"></div>
    <div class="wrap hero-cinematic__content">
      <div class="hero-cinematic__badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span class="label">Est. 2015 &middot; Auckland, NZ</span>
      </div>

      <h1 class="display hero-cinematic__title">
        A haircut worth the <span class="text-gold">appointment</span>
      </h1>

      <p class="lede hero-cinematic__lede">
        Two Auckland shops. Japanese barbering discipline, Western technique,
        and a chair that runs on time. Cuts from ${from}, skin fades $55,
        hot towel shaves $65.
      </p>

      <div class="hero-cinematic__actions">
        <div class="hero-action-group">
          <BookingButton location={ponsonby} placement="hero" />
          <span class="hero-action-note">279 Ponsonby Rd &bull; 7 Days</span>
        </div>
        <div class="hero-action-group">
          <BookingButton location={remuera} placement="hero" variant="ghost" />
          <span class="hero-action-note">352 Remuera Rd &bull; Barber &amp; Nails</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       TWO SANCTUARIES: Visual Shop Chooser with real photos
       ========================================================== -->
  <section class="section on-deep" aria-labelledby="shops-head">
    <div class="wrap">
      <SectionHead n="01" label="Choose Your Shop" title="Two shops, five minutes apart" id="shops-head" />

      <div class="shop-cards">
        <!-- Ponsonby Card -->
        <article class="shop-card">
          <div class="shop-card__image-wrap">
            <img src="/images/shops/ponsonby-interior.png" alt="Tokoya Ponsonby interior" class="shop-card__img" loading="lazy" />
            <div class="shop-card__img-overlay"></div>
            <div class="shop-card__badge-top">
              <OpenNow hours={ponsonby.data.hours} />
              <span class="shop-tag-pill">Open 7 Days</span>
            </div>
          </div>
          <div class="shop-card__body">
            <div class="shop-card__header">
              <h3 class="display shop-card__title">Ponsonby</h3>
              <p class="shop-card__sub">{ponsonby.data.tagline}</p>
            </div>

            <div class="shop-card__info-grid">
              <div>
                <span class="label">Address</span>
                <p>{ponsonby.data.streetAddress}, {ponsonby.data.suburb}</p>
              </div>
              <div>
                <span class="label">Cuts From</span>
                <p class="font-anton text-lg text-gold">${priceFrom(atLocation(services, 'ponsonby').filter((s) => s.data.group === 'haircuts'))}</p>
              </div>
              <div>
                <span class="label">Hours</span>
                <p>{openDaysSummary(ponsonby.data.hours)}</p>
              </div>
              <div>
                <span class="label">Booking System</span>
                <p>{ponsonby.data.bookingProvider}</p>
              </div>
            </div>

            <div class="shop-card__actions">
              <BookingButton location={ponsonby} placement="card" block />
              <a class="shop-card__link" href="/ponsonby/">
                Explore Ponsonby shop details &rarr;
              </a>
            </div>
          </div>
        </article>

        <!-- Remuera Card -->
        <article class="shop-card">
          <div class="shop-card__image-wrap">
            <img src="/images/shops/remuera-salon.png" alt="Tokoya Remuera salon" class="shop-card__img" loading="lazy" />
            <div class="shop-card__img-overlay"></div>
            <div class="shop-card__badge-top">
              <OpenNow hours={remuera.data.hours} />
              <span class="shop-tag-pill">Barber &amp; Nail Salon</span>
            </div>
          </div>
          <div class="shop-card__body">
            <div class="shop-card__header">
              <h3 class="display shop-card__title">Remuera</h3>
              <p class="shop-card__sub">{remuera.data.tagline}</p>
            </div>

            <div class="shop-card__info-grid">
              <div>
                <span class="label">Address</span>
                <p>{remuera.data.streetAddress}, {remuera.data.suburb}</p>
              </div>
              <div>
                <span class="label">Cuts / Nails</span>
                <p class="font-anton text-lg text-gold">$30 <span class="text-xs text-muted">/ Gel $65</span></p>
              </div>
              <div>
                <span class="label">Hours</span>
                <p>{openDaysSummary(remuera.data.hours)}</p>
              </div>
              <div>
                <span class="label">Booking System</span>
                <p>{remuera.data.bookingProvider}</p>
              </div>
            </div>

            <div class="shop-card__actions">
              <BookingButton location={remuera} placement="card" block />
              <a class="shop-card__link" href="/remuera/">
                Explore Remuera salon details &rarr;
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       ETHOS & DISCIPLINE: Craftsmanship & Detail Photography
       ========================================================== -->
  <section class="section on-ink" aria-labelledby="craft-head">
    <div class="wrap">
      <div class="craft-grid">
        <div class="craft-copy">
          <p class="label">The Philosophy &middot; 床屋</p>
          <h2 class="display craft-title" id="craft-head">
            Operate at the highest level of service excellence
          </h2>
          <p class="lede">
            Our shops are immaculately clean, with a calm, polite, and professional environment.
          </p>
          <div class="craft-values">
            <div class="value-item">
              <span class="disc">01</span>
              <div>
                <h3 class="value-title">Family-oriented yet stylish</h3>
                <p class="value-desc">A comfortable, respectful atmosphere for gentlemen, women, and children alike.</p>
              </div>
            </div>
            <div class="value-item">
              <span class="disc">02</span>
              <div>
                <h3 class="value-title">Detail-driven yet warm</h3>
                <p class="value-desc">Every cut, fade, and hot towel shave is executed with deliberate precision and genuine hospitality.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="craft-images">
          <div class="craft-img-card">
            <img src="/images/craft/scissors-clippers.png" alt="Barbering precision tools" loading="lazy" />
          </div>
          <div class="craft-img-card craft-img-card--offset">
            <img src="/images/craft/barber-chair-tools.png" alt="Classic barber chair and grooming station" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       THE CRAFTSMEN: Real portraits of the barbers
       ========================================================== -->
  <section class="section on-deep" aria-labelledby="team-head">
    <div class="wrap">
      <SectionHead n="02" label="Master Craftsmen" title="The team behind the chair" id="team-head" />

      <ul class="barber-grid">
        {team.map((t) => (
          <li class="barber-card">
            <div class="barber-card__photo">
              {t.data.image ? (
                <img src={t.data.image} width="340" height="420" alt={`${t.data.name}, barber at Tokoya`} loading="lazy" />
              ) : (
                <div class="barber-card__placeholder">{t.data.name.charAt(0)}</div>
              )}
              <div class="barber-card__gradient"></div>
              <div class="barber-card__tags">
                {t.data.locations.map((loc) => (
                  <span class="barber-location-tag">{loc === 'ponsonby' ? 'Ponsonby' : 'Remuera'}</span>
                ))}
              </div>
            </div>
            <div class="barber-card__meta">
              <h3 class="barber-name">{t.data.name}</h3>
              <p class="barber-role">{t.data.title}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==========================================================
       SERVICES & PRICES: Clear, upfront pricing cards
       ========================================================== -->
  <section class="section on-ink" aria-labelledby="services-head">
    <div class="wrap">
      <SectionHead n="03" label="Signature Services" title="Upfront price & time, before you book" id="services-head" />

      <ul class="service-cards">
        {featured.map((s) => (
          <li class="service-card">
            <div class="service-card__top">
              <span class="service-card__price font-anton">{formatPrice(s.data)}</span>
              <span class="service-card__dur num">{formatDuration(s.data)}</span>
            </div>
            <h3 class="service-card__title">{s.data.title}</h3>
            <p class="service-card__sum">{s.data.summary || 'Expert grooming tailored to your style.'}</p>
            <div class="service-card__foot">
              {s.data.locations.length === 1 && (
                <span class="service-card__only">
                  {s.data.locations[0] === 'remuera' ? 'Remuera only' : 'Ponsonby only'}
                </span>
              )}
              <a class="service-card__book" href="/prices/">
                View on Price Board &rarr;
              </a>
            </div>
          </li>
        ))}
      </ul>

      <div class="service-all-cta">
        <a class="btn btn--ghost" href="/prices/">
          <span>View Complete Price Board &amp; Durations</span>
          <span class="btn__arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 8h11M9 4l4 4-4 4" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       CLIENT PRAISE / SOCIAL PROOF
       ========================================================== -->
  <section class="section on-deep" aria-label="Customer Reviews">
    <div class="wrap">
      <div class="review-box">
        <div class="review-quote-mark">&ldquo;</div>
        <p class="review-text">
          Jojo and Kris are great! Love coming here for a haircut. So easy and relaxing.
          I always enjoy coming back because they remember my cut and know how I like it.
        </p>
        <div class="review-author">
          <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="label">Verified Tokoya Client &middot; Auckland</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       BOTTOM CALL TO ACTION: Atmospheric Station Backdrop
       ========================================================== -->
  <section class="bottom-cta">
    <div class="bottom-cta__bg" style="background-image: url('/images/hero/hero-station.png');"></div>
    <div class="bottom-cta__overlay"></div>
    <div class="wrap bottom-cta__content">
      <p class="label">Ready for your visit?</p>
      <h2 class="display bottom-cta__title">Select your shop &amp; book online</h2>
      <p class="lede bottom-cta__lede">
        Appointments recommended to guarantee your chair. Walk-ins welcome when space permits.
      </p>
      <div class="bottom-cta__buttons">
        <BookingButton location={ponsonby} placement="hero" />
        <BookingButton location={remuera} placement="hero" variant="ghost" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Cinematic Hero ------------------------------------------------ */
  .hero-cinematic {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: var(--s-9) var(--s-8);
  }
  .hero-cinematic__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 35%;
    transform: scale(1.03);
    z-index: 1;
  }
  .hero-cinematic__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(8, 7, 6, 0.95) 0%,
      rgba(14, 12, 10, 0.88) 45%,
      rgba(8, 7, 6, 0.6) 100%
    );
    z-index: 2;
  }
  .hero-cinematic__content {
    position: relative;
    z-index: 3;
    max-width: var(--max);
  }
  .hero-cinematic__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem;
    background: rgba(20, 16, 12, 0.85);
    border: 1px solid rgba(201, 169, 135, 0.3);
    border-radius: 9999px;
    backdrop-filter: blur(8px);
    margin-bottom: var(--s-5);
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bronze-gold);
    flex-shrink: 0;
  }
  .hero-cinematic__title {
    font-size: var(--step-4);
    max-width: 14ch;
    line-height: 0.92;
    margin-bottom: var(--s-5);
  }
  .text-gold { color: var(--bronze-gold); }
  .hero-cinematic__lede {
    font-size: var(--step-1);
    max-width: 48ch;
    color: rgba(250, 247, 242, 0.9);
    margin-bottom: var(--s-7);
  }
  .hero-cinematic__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
  }
  .hero-action-group {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .hero-action-note {
    font-size: var(--step--1);
    color: rgba(250, 247, 242, 0.6);
    letter-spacing: 0.05em;
  }

  /* ---- Two Sanctuaries / Shop Cards ---------------------------------- */
  .shop-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-6);
  }
  .shop-card {
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }
  .shop-card:hover {
    transform: translateY(-4px);
    border-color: var(--ink-card-border-hover);
    box-shadow: var(--shadow-lg), var(--shadow-glow);
  }
  .shop-card__image-wrap {
    position: relative;
    height: 240px;
    overflow: hidden;
  }
  .shop-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .shop-card:hover .shop-card__img {
    transform: scale(1.05);
  }
  .shop-card__img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(22, 18, 14, 0.9) 0%, transparent 60%);
  }
  .shop-card__badge-top {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    right: var(--s-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 2;
  }
  .shop-tag-pill {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    background: rgba(14, 12, 10, 0.85);
    color: var(--bronze-bright);
    border: 1px solid rgba(201, 169, 135, 0.3);
    backdrop-filter: blur(6px);
  }
  .shop-card__body {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    flex: 1;
  }
  .shop-card__header {
    border-bottom: 1px solid var(--rule-ink);
    padding-bottom: var(--s-4);
  }
  .shop-card__title {
    font-size: var(--step-3);
    color: var(--paper);
  }
  .shop-card__sub {
    color: rgba(250, 247, 242, 0.7);
    font-size: var(--step-0);
  }
  .shop-card__info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
  }
  .shop-card__info-grid p {
    margin: 0;
    font-weight: 500;
    color: var(--paper);
  }
  .shop-card__actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .shop-card__link {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--bronze-bright);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  .shop-card__link:hover { text-decoration: underline; }

  /* ---- Craft Grid ---------------------------------------------------- */
  .craft-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-7);
    align-items: center;
  }
  .craft-title {
    font-size: var(--step-3);
    margin-top: var(--s-2);
    margin-bottom: var(--s-4);
    line-height: 1;
  }
  .craft-values {
    margin-top: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .value-item {
    display: flex;
    gap: var(--s-4);
    align-items: flex-start;
  }
  .value-title {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--bronze-gold);
    margin-bottom: 0.25rem;
  }
  .value-desc {
    color: rgba(250, 247, 242, 0.75);
    font-size: var(--step--1);
    margin: 0;
  }
  .craft-images {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
    position: relative;
  }
  .craft-img-card {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--ink-card-border);
    box-shadow: var(--shadow-md);
  }
  .craft-img-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .craft-img-card--offset {
    margin-top: var(--s-6);
  }

  /* ---- Barber Grid --------------------------------------------------- */
  .barber-grid {
    list-style: none;
    padding: 0;
    margin: var(--s-6) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--s-5);
  }
  .barber-card {
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .barber-card:hover {
    transform: translateY(-4px);
    border-color: var(--bronze-bright);
  }
  .barber-card__photo {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--ink-surface);
  }
  .barber-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }
  .barber-card:hover .barber-card__photo img {
    transform: scale(1.06);
  }
  .barber-card__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14, 12, 10, 0.8) 0%, transparent 40%);
  }
  .barber-card__tags {
    position: absolute;
    bottom: var(--s-3);
    left: var(--s-3);
    display: flex;
    gap: 0.35rem;
    z-index: 2;
  }
  .barber-location-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(14, 12, 10, 0.85);
    color: var(--bronze-bright);
    border: 1px solid rgba(201, 169, 135, 0.25);
  }
  .barber-card__meta {
    padding: var(--s-4);
  }
  .barber-name {
    font-size: var(--step-0);
