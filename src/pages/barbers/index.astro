---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import BookingButton from '../../components/BookingButton.astro';
import { getCollection } from 'astro:content';
import heroCraft from '../../assets/images/hero/hero-craft.png';

const team = (await getCollection('team')).filter((t) => t.data.confirmed);
const locations = await getCollection('locations');

const ponsonby = locations.find((l) => l.data.slug === 'ponsonby')!;
const remuera = locations.find((l) => l.data.slug === 'remuera')!;

const title = "Our Barbers & Master Craftsmen | Tokoya Barber & Shop";
const description = "Meet the team of master barbers at Tokoya Barber & Shop in Ponsonby and Remuera. Meet Etsuya Kidoguchi, James, Jojo Parido, and Kim Duong.";
---

<BaseLayout title={title} description={description}>

  <!-- Hero Banner -->
  <section class="barbers-hero">
    <Image src={heroCraft} alt="" class="barbers-hero__bg" format="avif" loading="eager" fetchpriority="high" width={1400} height={600} />
    <div class="barbers-hero__overlay"></div>
    <div class="wrap barbers-hero__content">
      <span class="label">Master Craftsmen &middot; The Chair</span>
      <h1 class="display barbers-hero__title">
        The Hands Behind The Shears
      </h1>
      <p class="lede barbers-hero__lede">
        Our multicultural team brings together decades of expertise from Japan, Korea, Vietnam, the Philippines, and New Zealand.
        Precision shears, clean fades, and custom styling finished with imported <a href="/products/">professional products</a> in every chair.
      </p>
    </div>
  </section>

  <!-- Barbers Grid -->
  <section class="section on-deep">
    <div class="wrap">
      <SectionHead label="The Team" title="Choose Your Barber" />

      <div class="barbers-grid">
        {team.map((b) => {
          const bio = b.body.trim();
          const primaryLoc = b.data.locations.includes('ponsonby') ? ponsonby : remuera;
          return (
            <article class="barber-detail-card">
              <div class="barber-detail-card__photo-col">
                <div class="barber-photo-frame">
                  <a href={`/barbers/${b.slug}/`} class="barber-photo-link" aria-label={`View profile and book with ${b.data.name}`}>
                    {b.data.image ? (
                      <Image src={b.data.image} alt={`${b.data.name}, ${b.data.title}`} width={280} height={350} format="avif" loading="lazy" />
                    ) : (
                      <div class="barber-placeholder">{b.data.name.charAt(0)}</div>
                    )}
                  </a>
                  <div class="barber-photo-tags">
                    {b.data.locations.map((loc) => (
                      <span class="location-badge">{loc === 'ponsonby' ? 'Ponsonby' : 'Remuera'}</span>
                    ))}
                  </div>
                </div>
              </div>

              <div class="barber-detail-card__content-col">
                <div>
                  <h2 class="display barber-detail-name">
                    <a href={`/barbers/${b.slug}/`} class="barber-name-link">{b.data.name}</a>
                  </h2>
                  <p class="barber-detail-title">{b.data.title}</p>
                  <p class="barber-detail-bio">{bio}</p>
                </div>

                <div class="barber-detail-actions">
                  {b.data.locations.includes('ponsonby') && (
                    <BookingButton location={ponsonby} barber={b.data.name} placement="card" />
                  )}
                  {b.data.locations.includes('remuera') && (
                    <BookingButton location={remuera} barber={b.data.name} staffId={b.data.freshaStaffId} placement="card" variant={b.data.locations.includes('ponsonby') ? 'ghost' : 'solid'} />
                  )}
                  <a href={`/barbers/${b.slug}/`} class="barber-profile-link">
                    Profile &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .barbers-hero {
    position: relative;
    padding-block: var(--s-9) var(--s-8);
    overflow: hidden;
    min-height: 48vh;
    display: flex;
    align-items: center;
  }
  .barbers-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }
  .barbers-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(8, 7, 6, 0.95) 0%, rgba(14, 12, 10, 0.88) 50%, rgba(8, 7, 6, 0.7) 100%);
    z-index: 2;
  }
  .barbers-hero__content {
    position: relative;
    z-index: 3;
    max-width: var(--max);
  }
  .barbers-hero__title {
    font-size: var(--step-4);
    margin-top: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .barbers-hero__lede {
    max-width: 50ch;
  }
  .barbers-hero__lede a {
    color: var(--bronze-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .barbers-hero__lede a:hover {
    color: var(--cream);
  }

  .barbers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-6);
  }

  .barber-detail-card {
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 140px 1fr;
    transition: border-color 140ms ease;
  }
  .barber-detail-card:hover {
    border-color: var(--bronze-bright);
  }

  .barber-detail-card__photo-col {
    position: relative;
    background: var(--ink-surface);
  }
  .barber-photo-frame {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }
  .barber-photo-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .barber-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .barber-photo-tags {
    position: absolute;
    bottom: var(--s-2);
    left: var(--s-2);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 2;
  }
  .location-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(14, 12, 10, 0.9);
    color: var(--bronze-bright);
    border: 1px solid rgba(201, 169, 135, 0.3);
  }

  .barber-detail-card__content-col {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .barber-detail-name {
    font-size: var(--step-2);
    color: var(--paper);
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .barber-detail-title {
    font-size: var(--step--1);
    color: var(--bronze-gold);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--s-3);
  }
  .barber-detail-bio {
    font-size: var(--step--1);
    color: rgba(250, 247, 242, 0.78);
    line-height: 1.55;
  }
  .barber-detail-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }
  .barber-name-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .barber-name-link:hover {
    color: var(--bronze-bright);
  }
  .barber-profile-link {
    font-size: var(--step--1);
    color: var(--bronze-bright);
    text-decoration: none;
    font-weight: 500;
    margin-left: auto;
    transition: transform 150ms ease;
  }
  .barber-profile-link:hover {
    transform: translateX(3px);
  }

  @media (max-width: 32rem) {
    .barber-detail-card {
      grid-template-columns: 1fr;
    }
    .barber-photo-frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
