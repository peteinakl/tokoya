---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import BookingButton from '../../components/BookingButton.astro';
import { getCollection } from 'astro:content';

const team = (await getCollection('team')).filter((t) => t.data.confirmed);
const locations = await getCollection('locations');

const ponsonby = locations.find((l) => l.data.slug === 'ponsonby')!;
const remuera = locations.find((l) => l.data.slug === 'remuera')!;

// Bios harvested from the live site
const bios: Record<string, string> = {
  "Kris Torcato": "With over two decades of experience in the barbering industry, Kris is passionate about delivering exceptional grooming that enhances each client's personal style.",
  "Jojo Parido": "Shaping & styling hair for a living is what Jojo loves and cares deeply about, bringing high-detail fades and precision scissors to Remuera.",
  "Kim Duong": "With 8 years of master barbering experience in Vietnam, Kim is passionate about modern, fashion-forward cuts and traditional razor techniques.",
  "Justin Park": "Originally from South Korea with a background as a tattoo artist, Justin brings meticulous geometric precision and sharp attention to detail behind the chair.",
  "James": "A dedicated craftsman at Ponsonby known for attentive consultations, sharp taper fades, and classic gentlemen's scissor cuts.",
  "Etsuya Kidoguchi": "Specializing in Japanese barbering technique, discipline, clean fades, and restorative hot towel beard treatments."
};

const title = "Our Barbers & Master Craftsmen | Tokoya Auckland";
const description = "Meet the team of master barbers at Tokoya Barber & Shop in Ponsonby and Remuera. Meet Kris Torcato, Jojo Parido, Kim Duong, Justin Park, James, and Etsuya Kidoguchi.";
---

<BaseLayout title={title} description={description}>

  <!-- Hero Banner -->
  <section class="barbers-hero">
    <div class="barbers-hero__bg" style="background-image: url('/images/hero/hero-craft.png');"></div>
    <div class="barbers-hero__overlay"></div>
    <div class="wrap barbers-hero__content">
      <span class="label">Master Craftsmen &middot; The Chair</span>
      <h1 class="display barbers-hero__title">
        The Hands Behind The Shears
      </h1>
      <p class="lede barbers-hero__lede">
        Our multicultural team brings together decades of expertise from Japan, Korea, Vietnam, and New Zealand.
        Precision, punctuality, and pride in the craft.
      </p>
    </div>
  </section>

  <!-- Barbers Grid -->
  <section class="section on-deep">
    <div class="wrap">
      <SectionHead label="The Team" title="Choose Your Barber" />

      <div class="barbers-grid">
        {team.map((b) => {
          const bio = bios[b.data.name] || "Passionate about traditional Japanese discipline, contemporary scissor craft, and punctual chair hospitality.";
          const primaryLoc = b.data.locations.includes('ponsonby') ? ponsonby : remuera;
          return (
            <article class="barber-detail-card">
              <div class="barber-detail-card__photo-col">
                <div class="barber-photo-frame">
                  <img src={b.data.image} alt={`${b.data.name}, ${b.data.title}`} loading="lazy" />
                  <div class="barber-photo-tags">
                    {b.data.locations.map((loc) => (
                      <span class="location-badge">{loc === 'ponsonby' ? 'Ponsonby' : 'Remuera'}</span>
                    ))}
                  </div>
                </div>
              </div>

              <div class="barber-detail-card__content-col">
                <div>
                  <h2 class="display barber-detail-name">
                    <a href={`/barbers/${b.slug}/`} class="barber-name-link">{b.data.name}</a>
                  </h2>
                  <p class="barber-detail-title">{b.data.title}</p>
                  <p class="barber-detail-bio">{bio}</p>
                </div>

                <div class="barber-detail-actions">
                  {b.data.locations.includes('ponsonby') && (
                    <BookingButton location={ponsonby} barber={b.data.name} placement="card" />
                  )}
                  {b.data.locations.includes('remuera') && (
                    <BookingButton location={remuera} barber={b.data.name} staffId={b.data.freshaStaffId} placement="card" variant={b.data.locations.includes('ponsonby') ? 'ghost' : 'solid'} />
                  )}
                  <a href={`/barbers/${b.slug}/`} class="barber-profile-link">
                    Profile &rarr;
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .barbers-hero {
    position: relative;
    padding-block: var(--s-9) var(--s-8);
    overflow: hidden;
    min-height: 48vh;
    display: flex;
    align-items: center;
  }
  .barbers-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }
  .barbers-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(8, 7, 6, 0.95) 0%, rgba(14, 12, 10, 0.88) 50%, rgba(8, 7, 6, 0.7) 100%);
    z-index: 2;
  }
  .barbers-hero__content {
    position: relative;
    z-index: 3;
    max-width: var(--max);
  }
  .barbers-hero__title {
    font-size: var(--step-4);
    margin-top: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .barbers-hero__lede {
    max-width: 50ch;
  }

  .barbers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-6);
  }

  .barber-detail-card {
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 8px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 140px 1fr;
    box-shadow: var(--shadow-md);
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .barber-detail-card:hover {
    transform: translateY(-3px);
    border-color: var(--bronze-bright);
  }

  .barber-detail-card__photo-col {
    position: relative;
    background: var(--ink-surface);
  }
  .barber-photo-frame {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }
  .barber-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }
  .barber-detail-card:hover .barber-photo-frame img {
    transform: scale(1.05);
  }

  .barber-photo-tags {
    position: absolute;
    bottom: var(--s-2);
    left: var(--s-2);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 2;
  }
  .location-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(14, 12, 10, 0.9);
    color: var(--bronze-bright);
    border: 1px solid rgba(201, 169, 135, 0.3);
  }

  .barber-detail-card__content-col {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .barber-detail-name {
    font-size: var(--step-2);
    color: var(--paper);
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .barber-detail-title {
    font-size: var(--step--1);
    color: var(--bronze-gold);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--s-3);
  }
  .barber-detail-bio {
    font-size: var(--step--1);
    color: rgba(250, 247, 242, 0.78);
    line-height: 1.55;
  }
  .barber-detail-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }
  .barber-name-link {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .barber-name-link:hover {
    color: var(--bronze-bright);
  }
  .barber-profile-link {
    font-size: var(--step--1);
    color: var(--bronze-bright);
    text-decoration: none;
    font-weight: 500;
    margin-left: auto;
    transition: transform 150ms ease;
  }
  .barber-profile-link:hover {
    transform: translateX(3px);
  }

  @media (max-width: 32rem) {
    .barber-detail-card {
      grid-template-columns: 1fr;
    }
    .barber-photo-frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
