---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import BookingButton from '../components/BookingButton.astro';
import { getCollection } from 'astro:content';
import heroStation from '../assets/images/hero/hero-station.png';
import barberChairTools from '../assets/images/craft/barber-chair-tools.png';
import scissorsClippers from '../assets/images/craft/scissors-clippers.png';
import remueraSalon from '../assets/images/shops/remuera-salon.png';

const ORDER = ['ponsonby', 'remuera'];
const locations = (await getCollection('locations')).sort(
  (a, b) => ORDER.indexOf(a.data.slug) - ORDER.indexOf(b.data.slug)
);
const ponsonby = locations.find((l) => l.data.slug === 'ponsonby')!;
const remuera = locations.find((l) => l.data.slug === 'remuera')!;

const title = "About Us & Heritage | Tokoya Barber & Shop";
const description = "The story of Tokoya Barber & Shop. Founded in 2015 by Kaisei Sarai, blending Japanese barbering discipline with Western technique in Ponsonby and Remuera.";
---

<BaseLayout title={title} description={description}>

  <!-- Hero Banner -->
  <section class="about-hero">
    <Image src={heroStation} alt="" class="about-hero__bg" format="avif" loading="eager" fetchpriority="high" width={1400} height={600} />
    <div class="about-hero__overlay"></div>
    <div class="wrap about-hero__content">
      <span class="label">Our Heritage &middot; 床屋</span>
      <h1 class="display about-hero__title">
        The Tokoya Story
      </h1>
      <p class="lede about-hero__lede">
        Japanese barbering discipline, Western technique, and a space where grooming is treated as a refined ritual.
      </p>
    </div>
  </section>

  <!-- Section 1: Origins -->
  <section class="section on-deep">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-copy">
          <SectionHead label="Est. 2015" title="Precision. Tradition. Excellence." />
          <div class="story-text">
            <p>
              Tokoya Barber &amp; Shop was established in 2015 by award-winning barber <strong>Kaisei Sarai</strong>, whose vision was to blend traditional Japanese barbering techniques with world-class grooming service.
            </p>
            <p>
              Under Kaisei’s leadership, Tokoya quickly earned a stellar reputation as one of Auckland’s premier barbershops, respected for its clean aesthetic, exceptional craftsmanship, and welcoming, family-friendly service.
            </p>
            <p>
              In recent years, Tokoya has entered an exciting new chapter under the direction &amp; leadership of <strong>Kaori Sasaki</strong> and <strong>Roshan Dsouza</strong>, who continue to uphold the founding legacy while expanding the brand's offerings across Auckland.
            </p>
          </div>
        </div>

        <div class="about-image-card">
          <Image src={barberChairTools} alt="Tokoya classic chair" format="avif" width={600} height={450} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Meaning of 床屋 -->
  <section class="section on-ink">
    <div class="wrap">
      <div class="kanji-banner">
        <div class="kanji-display">床屋</div>
        <div class="kanji-copy">
          <p class="label">The Name</p>
          <h2 class="display kanji-title">Grooming as a Refined Ritual</h2>
          <p class="lede">
            The word <strong>Tokoya</strong> (床屋) is Japanese for “barbershop”, a space where self-care is not just routine, but a thoughtful, unhurried discipline.
          </p>
          <p class="text-sm text-[#faf7f2]/75">
            At Tokoya, we embody that meaning in everything we do: punctual chairs, razor-sharp scissor work, immaculate shop hygiene, and genuine respect for every client who sits before us.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Multicultural Craft & Team -->
  <section class="section on-deep">
    <div class="wrap">
      <div class="about-grid about-grid--reverse">
        <div class="about-copy">
          <SectionHead label="The Team" title="Multicultural Expertise & Dual Training" />
          <div class="story-text">
            <p>
              Our team brings together master barbers and stylists from Japan, Korea, Vietnam, the Philippines, and New Zealand. Together, our professionals share decades of combined expertise behind the chair.
            </p>
            <p>
              Whether you’re after a classic taper, a high skin fade, a sharp beard lineup, or a restorative hot towel shave, every cut is delivered with deliberate skill, precision clippers, and attentive care.
            </p>
            <p>
              We welcome men, women, and children, taking pride in creating a comfortable, family-oriented atmosphere where everyone walks out looking sharp.
            </p>
            <div class="about-actions">
              <a href="/barbers/" class="btn btn--ghost">
                <span>Meet Our Barbers</span> &rarr;
              </a>
            </div>
          </div>
        </div>

        <div class="about-image-card">
          <Image src={scissorsClippers} alt="Precision barbering shears" format="avif" width={600} height={450} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: Remuera Expansion -->
  <section class="section on-ink">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-copy">
          <SectionHead label="Expansion" title="Tokoya Barber & Salon: Remuera" />
          <div class="story-text">
            <p>
              As part of our continued growth, Kaori and Roshan launched <strong>Tokoya Barber &amp; Salon</strong> at 352 Remuera Road.
            </p>
            <p>
              This location expands upon our original Ponsonby barbershop concept by offering full master barbering alongside a dedicated <strong>nail salon for both men and women</strong>, offering gel manicures, pedicures, skin fades, and hot towel shaves to bring your grooming into one welcoming space.
            </p>
            <p>
              Every cut and shave across both locations is finished with authentic <a href="/products/">imported grooming products</a> including Layrite, Uppercut Deluxe, and Proraso, which are also available for purchase at our counters.
            </p>
            <div class="about-actions">
              <BookingButton location={ponsonby} placement="card" />
              <BookingButton location={remuera} placement="card" variant="ghost" />
            </div>
          </div>
        </div>

        <div class="about-image-card">
          <Image src={remueraSalon} alt="Tokoya Remuera Barber & Salon" format="avif" width={600} height={450} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    position: relative;
    padding-block: var(--s-9) var(--s-8);
    overflow: hidden;
    min-height: 50vh;
    display: flex;
    align-items: center;
  }
  .about-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }
  .about-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(8, 7, 6, 0.95) 0%, rgba(14, 12, 10, 0.88) 50%, rgba(8, 7, 6, 0.7) 100%);
    z-index: 2;
  }
  .about-hero__content {
    position: relative;
    z-index: 3;
    max-width: var(--max);
  }
  .about-hero__title {
    font-size: var(--step-4);
    margin-top: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .about-hero__lede {
    max-width: 48ch;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--s-8);
    align-items: center;
  }
  .about-grid--reverse {
    grid-template-columns: 1fr 1.2fr;
  }
  .about-grid--reverse .about-copy {
    order: 2;
  }
  .about-grid--reverse .about-image-card {
    order: 1;
  }

  .story-text p {
    font-size: var(--step-0);
    line-height: 1.65;
    color: rgba(250, 247, 242, 0.85);
    margin-bottom: var(--s-4);
  }
  .story-text strong {
    color: var(--paper);
  }
  .story-text a {
    color: var(--bronze-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .story-text a:hover {
    color: var(--cream);
  }
  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .about-image-card {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--ink-card-border);
  }
  .about-image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kanji-banner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-7);
    align-items: center;
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 12px;
    padding: var(--s-7);
  }
  .kanji-display {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 7rem);
    color: var(--bronze-gold);
    line-height: 1;
    padding: var(--s-4);
    background: rgba(14, 12, 10, 0.6);
    border-radius: 8px;
    border: 1px solid rgba(201, 169, 135, 0.2);
  }
  .kanji-title {
    font-size: var(--step-3);
    margin-top: var(--s-1);
    margin-bottom: var(--s-3);
  }

  @media (max-width: 52rem) {
    .about-grid, .about-grid--reverse {
      grid-template-columns: 1fr;
    }
    .about-grid--reverse .about-copy { order: 1; }
    .about-grid--reverse .about-image-card { order: 2; }
    .kanji-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .kanji-display { margin-inline: auto; }
  }
</style>
