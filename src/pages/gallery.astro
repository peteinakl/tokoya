---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import BookingButton from '../components/BookingButton.astro';
import { getCollection } from 'astro:content';
import heroCraft from '../assets/images/hero/hero-craft.png';
import heroChair from '../assets/images/hero/hero-chair.png';
import heroStation from '../assets/images/hero/hero-station.png';
import ponsonbyInterior from '../assets/images/shops/ponsonby-interior.png';
import remueraSalon from '../assets/images/shops/remuera-salon.png';
import ponsonbyChairs from '../assets/images/shops/ponsonby-chairs.png';
import scissorsClippers from '../assets/images/craft/scissors-clippers.png';
import barberChairTools from '../assets/images/craft/barber-chair-tools.png';

const locations = await getCollection('locations');
const ponsonby = locations.find((l) => l.data.slug === 'ponsonby')!;
const remuera = locations.find((l) => l.data.slug === 'remuera')!;
const team = (await getCollection('team')).filter((t) => t.data.confirmed);

const shopImages = [
  { img: ponsonbyInterior, title: 'Ponsonby Barber Stations', desc: 'Custom timber stations, warm vintage lighting, and classic barber chairs on Ponsonby Road.' },
  { img: remueraSalon, title: 'Remuera Barber & Nail Salon', desc: 'Our dual-craft salon at 352 Remuera Road, designed for haircuts, beard grooming, and specialised nail treatments.' },
  { img: ponsonbyChairs, title: 'The Ponsonby Chair Lineup', desc: 'Punctual, spotless chair arrangement where clients experience unhurried Japanese hospitality.' },
  { img: heroChair, title: 'Traditional Reclining Barber Chair', desc: 'Heavyweight ergonomic chairs engineered for precise hot towel shaves and beard sculpting.' }
];

const craftImages = [
  { img: scissorsClippers, title: 'Precision Clipper & Shear Work', desc: 'Sterilized shears and high-torque detailing clippers prepared before each appointment.' },
  { img: barberChairTools, title: 'The Barbering Station', desc: 'Straight razors, hot lather warmers, and imported styling balms kept at hand.' },
  { img: heroCraft, title: 'The Art of the Scissor Cut', desc: 'Attentive, millimeter-accurate hand scissor work tailored to each client’s facial geometry.' },
  { img: heroStation, title: 'Apothecary & Product Shelf', desc: 'Stocked with official Layrite, Uppercut Deluxe, and Proraso wet shaving formulations.' }
];

const title = "Gallery & Craft Portfolio | Tokoya Barber & Shop";
const description = "Explore the photography and craft of Tokoya Barber & Shop. View our Ponsonby and Remuera interiors, precision barbering tools, and master craftsmen.";
---

<BaseLayout title={title} description={description}>

  <!-- Hero -->
  <section class="gallery-hero">
    <Image src={heroCraft} alt="" class="gallery-hero__bg" format="avif" loading="eager" fetchpriority="high" width={1400} height={600} />
    <div class="gallery-hero__overlay"></div>
    <div class="wrap gallery-hero__content">
      <span class="label">Atmosphere &middot; Detail &middot; Discipline</span>
      <h1 class="display gallery-hero__title">The Craft In Focus</h1>
      <p class="lede gallery-hero__lede">
        A visual journey through our Ponsonby barbershop and Remuera salon.
        Immaculate hygiene, authentic Japanese discipline, and honest craftsmanship.
      </p>
    </div>
  </section>

  <!-- Section 1: The Shops -->
  <section class="section on-deep">
    <div class="wrap">
      <SectionHead label="The Spaces" title="Two Distinct Auckland Locations" />
      <div class="gallery-grid">
        {shopImages.map((img) => (
          <figure class="gallery-card">
            <div class="gallery-card__img-wrap">
              <Image src={img.img} alt={img.title} width={600} height={400} format="avif" loading="lazy" />
            </div>
            <figcaption class="gallery-card__caption">
              <h3 class="gallery-card__title">{img.title}</h3>
              <p class="gallery-card__desc">{img.desc}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: Craft & Discipline -->
  <section class="section on-ink">
    <div class="wrap">
      <SectionHead label="The Discipline" title="Precision Tools &amp; Rituals" />
      <div class="gallery-grid">
        {craftImages.map((img) => (
          <figure class="gallery-card">
            <div class="gallery-card__img-wrap">
              <Image src={img.img} alt={img.title} width={600} height={400} format="avif" loading="lazy" />
            </div>
            <figcaption class="gallery-card__caption">
              <h3 class="gallery-card__title">{img.title}</h3>
              <p class="gallery-card__desc">{img.desc}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: The Craftsmen -->
  <section class="section on-deep">
    <div class="wrap">
      <SectionHead label="Behind The Shears" title="The Tokoya Barbers" />
      <div class="barbers-photo-grid">
        {team.map((barber) => (
          <div class="barber-portrait-card">
            <div class="portrait-img-box">
              {barber.data.image ? (
                <Image src={barber.data.image} alt={barber.data.name} width={340} height={420} format="avif" loading="lazy" />
              ) : (
                <div class="barber-placeholder">{barber.data.name.charAt(0)}</div>
              )}
              <span class="portrait-loc-tag">{barber.data.locations.includes('ponsonby') ? 'Ponsonby' : 'Remuera'}</span>
            </div>
            <div class="portrait-meta">
              <h3 class="portrait-name font-anton">{barber.data.name}</h3>
              <p class="portrait-title text-gold text-sm">{barber.data.title}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="gallery-cta">
        <a href="/barbers/" class="btn btn--solid">
          <span>Read Barber Profiles &amp; Specialisms</span> &rarr;
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .gallery-hero {
    position: relative;
    padding-block: var(--s-9) var(--s-8);
    overflow: hidden;
    min-height: 48vh;
    display: flex;
    align-items: center;
  }
  .gallery-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }
  .gallery-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(8, 7, 6, 0.95) 0%, rgba(14, 12, 10, 0.88) 50%, rgba(8, 7, 6, 0.72) 100%);
    z-index: 2;
  }
  .gallery-hero__content {
    position: relative;
    z-index: 3;
    max-width: var(--max);
  }
  .gallery-hero__title {
    font-size: var(--step-4);
    margin-top: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .gallery-hero__lede {
    max-width: 52ch;
  }

  /* Gallery Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-6);
  }
  .gallery-card {
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
    display: flex;
    flex-direction: column;
    transition: border-color 140ms ease;
  }
  .gallery-card:hover {
    border-color: var(--bronze-gold);
  }
  .gallery-card__img-wrap {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-surface);
  }
  .gallery-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-card__caption {
    padding: var(--s-4);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .gallery-card__title {
    font-size: var(--step-0);
    color: var(--paper);
  }
  .gallery-card__desc {
    font-size: var(--step--1);
    color: rgba(250, 247, 242, 0.7);
    line-height: 1.45;
  }

  /* Barbers Grid */
  .barbers-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-6);
  }
  .barber-portrait-card {
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 8px;
    overflow: hidden;
  }
  .portrait-img-box {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--ink-surface);
  }
  .portrait-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait-loc-tag {
    position: absolute;
    bottom: var(--s-2);
    left: var(--s-2);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(14, 12, 10, 0.9);
    color: var(--bronze-bright);
    border: 1px solid rgba(201, 169, 135, 0.3);
  }
  .portrait-meta {
    padding: var(--s-3);
  }
  .portrait-name {
    font-size: var(--step-1);
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  .gallery-cta {
    margin-top: var(--s-7);
    text-align: center;
  }
</style>
