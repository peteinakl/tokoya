---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import BookingButton from '../components/BookingButton.astro';
import { getCollection } from 'astro:content';
import heroStation from '../assets/images/hero/hero-station.png';

const locations = await getCollection('locations');
const ponsonby = locations.find((l) => l.data.slug === 'ponsonby')!;
const remuera = locations.find((l) => l.data.slug === 'remuera')!;

const faqs = [
  {
    q: "Do I need to book an appointment, or can I just walk in?",
    a: "We strongly recommend booking online via <a href='https://apps.kitomba.com/bookings/toyokabarber'>Kitomba (Ponsonby)</a> or <a href='https://www.fresha.com/book-now/tokoya-barber-and-salon-itn6p8by/all-offer'>Fresha (Remuera)</a> to secure your chair time. We do accept walk-ins when a chair is available, but wait times can vary during peak hours and weekends."
  },
  {
    q: "What is the difference between the Ponsonby and Remuera locations?",
    a: "<strong>Ponsonby</strong> (279 Ponsonby Road) is our original classic barbershop open 7 days a week, dedicated to men’s grooming, skin fades, beard sculpting, and hot towel shaves. <strong>Remuera</strong> (352 Remuera Road) offers full barbering services alongside a <strong>dedicated nail salon</strong> catering to both men and women, including gel manicures, pedicures, and nail art."
  },
  {
    q: "What products do you use in the chair?",
    a: "We use exclusively premium imported grooming lines: <strong>Layrite Deluxe</strong> pomades and matte clays (USA), <strong>Uppercut Deluxe</strong> styling products (Australia), and authentic <strong>Proraso Firenze</strong> pre-shave creams, shaving soaps, and aftershaves (Italy). All products applied during your service are available for purchase at our shop counters."
  },
  {
    q: "Is Tokoya open on Sundays?",
    a: "Yes! Both our Ponsonby and Remuera locations are open on Sundays from <strong>9:00 AM to 4:00 PM</strong>. Sunday chair reservations fill fast, so we recommend booking ahead."
  },
  {
    q: "What is your cancellation policy?",
    a: "We understand plans change. We ask for at least <strong>90 minutes notice</strong> for cancellations or rescheduling. Cancellations within 90 minutes incur a 50% fee. Unnotified no-shows incur a 100% cancellation charge. More than two consecutive no-shows will result in suspension of online booking privileges."
  },
  {
    q: "Do you offer haircuts for children and seniors?",
    a: "Yes. We welcome clients of all ages. We offer a <strong>Child Haircut ($35, 30 min)</strong> for school-aged clients and a <strong>Student / Senior Haircut ($45, 30 min)</strong> for high school students and seniors aged 65 and over."
  },
  {
    q: "What is the meaning of the name 'Tokoya'?",
    a: "<strong>Tokoya (床屋)</strong> is the traditional Japanese noun for 'barbershop'. It represents a space of calm, meticulous hygiene, unhurried attention to detail, and deep respect for the ritual of grooming."
  },
  {
    q: "Can I get a beard trim and hot towel shave together?",
    a: "Absolutely. We offer our signature <strong>Hot Towel Shave ($65, 45 min)</strong>, as well as a combined <strong>Beard Trim & Shave ($45, 30 min)</strong> which shapes the beard with shears and clippers before defining the cheeks and neckline with a straight razor."
  }
];

const title = "Frequently Asked Questions | Tokoya Barber & Shop";
const description = "Answers to common questions about booking, opening hours, walk-ins, Sunday chairs, nail care in Remuera, and cancellation policies at Tokoya Barber & Shop.";

const SITE = 'https://www.tokoya.co.nz';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a.replace(/<[^>]+>/g, ''),
    },
  })),
};
---

<BaseLayout title={title} description={description} schema={schema}>

  <!-- Hero -->
  <section class="faq-hero">
    <Image src={heroStation} alt="" class="faq-hero__bg" format="avif" loading="eager" fetchpriority="high" width={1400} height={600} />
    <div class="faq-hero__overlay"></div>
    <div class="wrap faq-hero__content">
      <span class="label">Answers &middot; What To Expect</span>
      <h1 class="display faq-hero__title">Frequently Asked Questions</h1>
      <p class="lede faq-hero__lede">
        Everything you need to know about our chairs, appointments, locations, and grooming discipline before your visit.
      </p>
    </div>
  </section>

  <!-- FAQ Accordion List -->
  <section class="section on-deep">
    <div class="wrap">
      <div class="faq-layout">
        <div class="faq-main">
          <SectionHead label="Common Enquiries" title="Everything You Need To Know" />

          <div class="faq-accordion-group">
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary class="faq-item__question">
                  <span class="faq-q-text">{faq.q}</span>
                  <span class="faq-toggle-icon" aria-hidden="true">+</span>
                </summary>
                <div class="faq-item__answer">
                  <p set:html={faq.a} />
                </div>
              </details>
            ))}
          </div>
        </div>

        <!-- Sidebar Callout -->
        <aside class="faq-sidebar">
          <div class="faq-cta-box">
            <h3 class="display cta-box-title">Still Have Questions?</h3>
            <p class="cta-box-desc">
              Feel free to call our shops directly or visit our contact page to message our management team.
            </p>
            <div class="cta-box-contacts">
              <div class="cta-contact-row">
                <strong>Ponsonby Shop:</strong>
                <a href="tel:+6493784477">09 378 4477</a>
              </div>
              <div class="cta-contact-row">
                <strong>Remuera Salon:</strong>
                <a href="tel:+64266843107">026 684 3107</a>
              </div>
            </div>
            <div class="cta-box-buttons">
              <BookingButton location={ponsonby} placement="card" block />
              <BookingButton location={remuera} placement="card" block variant="ghost" />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .faq-hero {
    position: relative;
    padding-block: var(--s-9) var(--s-8);
    overflow: hidden;
    min-height: 48vh;
    display: flex;
    align-items: center;
  }
  .faq-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }
  .faq-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(8, 7, 6, 0.95) 0%, rgba(14, 12, 10, 0.88) 50%, rgba(8, 7, 6, 0.72) 100%);
    z-index: 2;
  }
  .faq-hero__content {
    position: relative;
    z-index: 3;
    max-width: var(--max);
  }
  .faq-hero__title {
    font-size: var(--step-4);
    margin-top: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .faq-hero__lede {
    max-width: 52ch;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--s-7);
    align-items: start;
    margin-top: var(--s-6);
  }
  @media (max-width: 56rem) {
    .faq-layout { grid-template-columns: 1fr; }
  }

  /* Accordions */
  .faq-accordion-group {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .faq-item {
    background: var(--ink-card);
    border: 1px solid var(--ink-card-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 150ms ease;
  }
  .faq-item[open] {
    border-color: var(--bronze-gold);
  }
  .faq-item__question {
    padding: var(--s-5);
    cursor: pointer;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--paper);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    list-style: none;
    user-select: none;
  }
  .faq-item__question::-webkit-details-marker {
    display: none;
  }
  .faq-toggle-icon {
    font-size: 1.5rem;
    color: var(--bronze-bright);
    transition: transform 180ms ease;
    flex: none;
    line-height: 1;
  }
  .faq-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
  }
  .faq-item__answer {
    padding: 0 var(--s-5) var(--s-5);
    font-size: var(--step--1);
    line-height: 1.65;
    color: rgba(250, 247, 242, 0.8);
    border-top: 1px solid rgba(201, 169, 135, 0.1);
    margin-top: 0.25rem;
    padding-top: var(--s-4);
  }
  .faq-item__answer a {
    color: var(--bronze-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .faq-item__answer a:hover {
    color: var(--cream);
  }

  /* Sidebar */
  .faq-cta-box {
    background: var(--ink-card);
    border: 1px solid rgba(201, 169, 135, 0.35);
    border-radius: 8px;
    padding: var(--s-6);
  }
  .cta-box-title {
    font-size: var(--step-2);
    margin-bottom: 0.25rem;
  }
  .cta-box-desc {
    font-size: var(--step--1);
    color: rgba(250, 247, 242, 0.7);
    line-height: 1.5;
    margin-bottom: var(--s-5);
  }
  .cta-box-contacts {
    background: var(--ink-surface);
    border: 1px solid var(--ink-card-border);
    border-radius: 6px;
    padding: var(--s-4);
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }
  .cta-contact-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--step--1);
  }
  .cta-contact-row a {
    color: var(--bronze-gold);
    text-decoration: none;
    font-weight: 500;
  }
  .cta-box-buttons {
    display: grid;
    gap: var(--s-3);
  }
</style>
